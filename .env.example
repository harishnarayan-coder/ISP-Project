# RENEWCAST Environment Configuration

# Backend Server Configuration
HOST=127.0.0.1
PORT=8000
DEBUG=True

# Weather API Settings
# By default, RENEWCAST uses the free Open-Meteo API without requiring any key.
# Optionally, you can specify an OpenWeatherMap API key:
OPENWEATHERMAP_API_KEY=

# CORS Origins
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
